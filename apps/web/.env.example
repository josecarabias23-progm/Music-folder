# Variables de entorno del frontend (Vite).
#
# IMPORTANTE: toda variable con prefijo VITE_ se incrusta en el bundle que se
# sirve al navegador y por lo tanto es pública. No guardes secretos aquí.

# Origen de la API. El cliente agrega el sufijo /api/v1 automáticamente.
# Se acepta con o sin esquema (ej. "localhost:3001" o "https://api.ejemplo.com").
VITE_API_URL=http://localhost:3001

# Clave de Google Stitch: debe permanecer vacía en el cliente. La llamada tiene
# que hacerse desde la API (proxy) para que la clave nunca llegue al navegador.
# Si ya se expuso una clave, rótala en Google Cloud antes de volver a usarla.
# VITE_STITCH_API_KEY=
