# ---------------------------------------------------------------------------
# apps/api — variables de entorno
# Copiar a .env localmente o definirlas en el panel del proveedor (producción).
# ---------------------------------------------------------------------------

# --- Base de datos ----------------------------------------------------------
# Postgres gestionado (Render, Neon, Supabase...). Tiene prioridad sobre POSTGRES_*.
#DATABASE_URL=postgresql://usuario:password@localhost:5432/music_folder
# Tipo explícito: postgres | sqlite. Si no se define, se usa postgres cuando hay
# DATABASE_URL y sqlite en caso contrario.
#DB_TYPE=postgres
# Ruta del archivo SQLite (sólo desarrollo local con DB_TYPE=sqlite).
#SQLITE_DB_PATH=./db/music-folder.sqlite
# SSL para Postgres externo (las conexiones internas de Render no lo necesitan).
#DB_SSL=false
# Alternativa a DATABASE_URL (Postgres por partes).
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgrespassword
#POSTGRES_DB=music_folder

# --- Esquema ----------------------------------------------------------------
# El esquema se aplica con migraciones versionadas:
#   npm --workspace apps/api run migration:run        (usa dist/)
#   npm --workspace apps/api run migration:run:dev    (usa ts-node)
# `true` altera el esquema en cada arranque y puede destruir datos: sólo en desarrollo.
#DB_SYNCHRONIZE=false

# --- Autenticación ----------------------------------------------------------
# OBLIGATORIA en producción: si falta, la API no arranca (fail-fast).
# Generar, por ejemplo, con: openssl rand -hex 32
#JWT_SECRET=

# --- Almacenamiento de partituras -------------------------------------------
# local = disco (`UPLOADS_DIR`); s3 = S3 o compatible (Cloudflare R2, MinIO, B2).
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# Con STORAGE_DRIVER=s3 instalar primero:
#   npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
#S3_BUCKET=music-folder
#S3_REGION=auto
#S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=false
#S3_PREFIX=scores
#S3_SIGNED_URL_EXPIRES_IN=300

# --- Servidor ---------------------------------------------------------------
#PORT=3001
#NODE_ENV=development