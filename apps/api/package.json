{
  "name": "@music-folder/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "seed": "ts-node-dev --respawn --transpile-only src/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm migration:run -d dist/config/typeorm.datasource.js",
    "migration:run:dev": "typeorm-ts-node-commonjs migration:run -d src/config/typeorm.datasource.ts",
    "migration:revert": "typeorm migration:revert -d dist/config/typeorm.datasource.js",
    "migration:show": "typeorm migration:show -d dist/config/typeorm.datasource.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/typeorm.datasource.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
